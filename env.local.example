# Agora credentials
# Required: found in Agora Console → your project → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=

# Required: found in Agora Console → your project → "App Certificate"
# Server-side only. Never expose this in client code.
NEXT_AGORA_APP_CERTIFICATE=

# MCP Integrations (Optional / Escalation Actions)
# Slack Incoming Webhook URL for real-time human agent alerts
SLACK_WEBHOOK_URL=

# Linear Personal API Key and Team ID for automatic issue creation
LINEAR_API_KEY=
LINEAR_TEAM_ID=
